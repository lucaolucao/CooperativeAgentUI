/* 页面 */

.ranking-page {

    max-width: 900px;

    margin: auto;

    padding: 40px;

}

/* 一列排列 */

.ranking-list {

    display: flex;

    flex-direction: column;

    gap: 18px;

}

/* 卡片 */

.item-card {

    background: white;

    border-radius: 18px;

    padding: 20px;

    box-shadow: 0 6px 18px rgba(0,0,0,.08);

    transition: .2s;

}

.item-card:hover{

    transform: translateY(-3px);

    box-shadow: 0 10px 24px rgba(0,0,0,.12);

}

/* Top */

.item-rank{

    font-size:18px;

    font-weight:bold;

    color:#2d5be3;

}

/* 图片 */

.item-image-wrapper{

    display:flex;

    justify-content:center;

    align-items:center;

    margin:18px 0;

    min-height:120px;

}

.item-image{

    width:90px;

    height:90px;

    object-fit:contain;

}

.item-emoji{

    font-size:64px;

}

/* 名称 */

.item-name{

    text-align:center;

    font-size:18px;

    font-weight:600;

}

/* Submit */

.submit-button{

    margin-top:30px;

    width:100%;

    padding:16px;

    border:none;

    border-radius:14px;

    background:#2d5be3;

    color:white;

    font-size:18px;

    cursor:pointer;

}

.submit-button:hover{

    background:#2048c8;

}